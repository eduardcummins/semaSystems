# Address shown on the site (footer, under the form, privacy policy). Defaults to hello@semasys.xyz.
CONTACT_EMAIL=
# Inbox that receives contact-form messages. Defaults to eduardcummins@gmail.com (direct, not via forwarding).
CONTACT_FORM_TO=
# Public base URL (canonical links, sitemap, share image). Defaults to the Vercel production domain, or http://localhost:3000 locally.
SITE_URL=
# Contact form email via Resend (semasys.xyz must be verified in Resend). Without a key, local submissions are
# logged to the console and the live form reports an error.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Sema Systems <website@semasys.xyz>

# Address that receives contact-form requests and is shown on the site. Defaults to eduardcummins@gmail.com.
CONTACT_EMAIL=
# Cal.com / Calendly link. If empty, "Book a free call" scrolls to the contact form.
BOOKING_URL=
# Public base URL (canonical links, sitemap, share image). Defaults to http://localhost:3000.
SITE_URL=
# Contact form email via Resend. Without a key, submissions are logged to the server console.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Sema Systems <onboarding@resend.dev>
